{
  "name": "gravitae",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:fresh": "rm -rf .next && next dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "next start",
    "docker": "docker compose up --build",
    "lint": "next typegen && eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --grep-invert @visual",
    "test-visual": "scripts/test-visual.sh",
    "eval": "vitest run --config vitest.eval.config.mts",
    "check": "scripts/ci.sh",
    "check:full": "scripts/ci.sh --full",
    "atomy-logs": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/atomy-logs.mts",
    "devtools": "devtools"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.114",
    "@ai-sdk/react": "^4.0.169",
    "ai": "^7.0.165",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/devtools": "1.0.74",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^8.1.2",
    "@playwright/test": "^1.65.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "qs": "^6.17.1",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
