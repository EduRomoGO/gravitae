# Copy to .env.local and fill in the values. .env.local is not versioned.

# Gemini API key: the chat and the reasoning's correction (advanced mode).
# Empty, the app runs in the reduced mode only.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional, only for `npm run eval`: OpenCode Go, the judge and the simulated
# reader. Without them the eval is skipped.
AI_API_KEY=
AI_BASE_URL=

# Optional, only for `npm run eval`: repeats per case (3 by default) and a
# comma-separated list of case ids to run.
EVAL_REPEATS=
EVAL_CASES=
